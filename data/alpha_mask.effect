uniform float4x4 ViewProj;
uniform texture2d image;

uniform texture2d mask;
uniform texture2d mask_prev;
/* Mask of a later frame and how far to blend towards it, for frames without a mask of their own */
uniform texture2d mask_next;
uniform float mask_mix;

/* Spacing of the refinement taps, in UV units */
uniform float2 tap_step;
/* Size of one image pixel, in UV units */
uniform float2 image_texel;

uniform float edge_lo;
uniform float edge_hi;
uniform float range_scale;
uniform float defringe_px;
uniform float smoothing;

sampler_state texSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float2 uv  : TEXCOORD0;
	float4 pos : POSITION;
};

struct FragData {
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData v_out;
	v_out.uv = v_in.uv;
	v_out.pos = mul(float4(v_in.pos.xyz, 1.), ViewProj);
	return v_out;
}

/* Temporal stabilisation, run once per new mask at mask resolution.
 * Small frame-to-frame changes (flicker) are blended with the previous mask,
 * large changes (real motion) pass through untouched so nothing trails. */
float4 PSStabilize(FragData f_in) : TARGET
{
	float cur = mask.Sample(texSampler, f_in.uv).r;
	float prev = mask_prev.Sample(texSampler, f_in.uv).r;
	float still = 1.0 - smoothstep(0.03, 0.25, abs(cur - prev));
	float value = lerp(cur, prev, smoothing * still);
	return float4(value, value, value, 1.0);
}

float mask_at(float2 pos)
{
	return lerp(mask.Sample(texSampler, pos).r, mask_next.Sample(texSampler, pos).r, mask_mix);
}

/* One tap of the joint bilateral upsample: the mask sample is weighted by how
 * close the image colour at the tap is to the colour at the pixel being shaded,
 * which pulls the low resolution mask edge onto the real edge in the image. */
float2 refine_tap(float2 uv, float2 offset, float3 ref_color, float spatial)
{
	float2 pos = uv + offset;
	float3 diff = image.Sample(texSampler, pos).rgb - ref_color;
	float weight = spatial * exp(-dot(diff, diff) * range_scale);
	return float2(mask_at(pos) * weight, weight);
}

float4 PSMask(FragData f_in) : TARGET
{
	float2 uv = f_in.uv;
	float4 rgba = image.Sample(texSampler, uv);

	float2 dx = float2(tap_step.x, 0.0);
	float2 dy = float2(0.0, tap_step.y);

	float2 acc = float2(mask_at(uv), 1.0);
	acc += refine_tap(uv, dx, rgba.rgb, 0.707);
	acc += refine_tap(uv, -dx, rgba.rgb, 0.707);
	acc += refine_tap(uv, dy, rgba.rgb, 0.707);
	acc += refine_tap(uv, -dy, rgba.rgb, 0.707);
	acc += refine_tap(uv, dx + dy, rgba.rgb, 0.5);
	acc += refine_tap(uv, dx - dy, rgba.rgb, 0.5);
	acc += refine_tap(uv, -dx + dy, rgba.rgb, 0.5);
	acc += refine_tap(uv, -dx - dy, rgba.rgb, 0.5);
	acc += refine_tap(uv, dx * 2.0, rgba.rgb, 0.25);
	acc += refine_tap(uv, dx * -2.0, rgba.rgb, 0.25);
	acc += refine_tap(uv, dy * 2.0, rgba.rgb, 0.25);
	acc += refine_tap(uv, dy * -2.0, rgba.rgb, 0.25);

	float alpha = smoothstep(edge_lo, edge_hi, acc.x / acc.y);

	/* Defringe: partially transparent edge pixels still carry the colour of the
	 * removed background. Replace it with colour from a little further inside
	 * the subject, found by walking up the mask gradient. */
	float2 grad = float2(mask_at(uv + dx) - mask_at(uv - dx), mask_at(uv + dy) - mask_at(uv - dy));
	float grad_len = length(grad);
	float2 inward = grad / max(grad_len, 0.0001);
	float3 inner = image.Sample(texSampler, uv + inward * image_texel * defringe_px).rgb;
	float pull = (1.0 - alpha) * step(0.01, grad_len) * step(0.001, defringe_px);
	rgba.rgb = lerp(rgba.rgb, inner, pull);

	return rgba * alpha;
}

technique Stabilize
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSStabilize(f_in);
	}
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSMask(f_in);
	}
}
